#include <winres.h>

#include "ps_version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Photoshop 2026 reads plug-in properties from an embedded JSON PiPL.
JSON_PIPL JSON "PiPLs.json"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FLARESIM_PS_VERSION_MAJOR, FLARESIM_PS_VERSION_MINOR, FLARESIM_PS_VERSION_PATCH, 0
 PRODUCTVERSION FLARESIM_PS_VERSION_MAJOR, FLARESIM_PS_VERSION_MINOR, FLARESIM_PS_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FlareSim physically based lens flare filter for Photoshop"
            VALUE "FileVersion", FLARESIM_PS_VERSION_STRING
            VALUE "InternalName", "FlareSimPS"
            VALUE "OriginalFilename", "FlareSimPS.8bf"
            VALUE "ProductName", FLARESIM_PS_PLUGIN_NAME
            VALUE "ProductVersion", FLARESIM_PS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
